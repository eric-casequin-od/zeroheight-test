  "boxShadow": {
    "thin": {
      "$extensions": {
        "com.figma.scopes": [
          "ALL_SCOPES"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 0
    }
  },
  "borderWidth": {
    "thick": {
      "$extensions": {
        "com.figma.scopes": [
          "STROKE_FLOAT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 2
    },
    "thicker": {
      "$extensions": {
        "com.figma.scopes": [
          "STROKE_FLOAT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 4
    },
    "thin": {
      "$extensions": {
        "com.figma.scopes": [
          "STROKE_FLOAT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 1
    },
    "default": {
      "$extensions": {
        "com.figma.scopes": [
          "STROKE_FLOAT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": "{borderWidth.thin}"
    }
  }
}