      "$value": 320
    },
    "medium": {
      "$extensions": {
        "com.figma.scopes": [
          "WIDTH_HEIGHT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 768
    },
    "small": {
      "$extensions": {
        "com.figma.scopes": [
          "WIDTH_HEIGHT"
        ],
