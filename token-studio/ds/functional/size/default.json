{
  "borderRadius": {
    "default": {
      "$extensions": {
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.hiddenFromPublishing": false,
        "com.figma.codeSyntax": {
          "Web": "var(--borderRadius-default) /* utility class: .rounded-2 */"
        }
      },
      "$type": "number",
      "$value": "{borderRadius.small}"
    },
    "large": {
      "$extensions": {
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.hiddenFromPublishing": false,
        "com.figma.codeSyntax": {
          "Web": "var(--borderRadius-large) /* utility class: .rounded-3 */"
        }
      },
      "$type": "number",
      "$value": 12
    },
    "medium": {
      "$extensions": {
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.hiddenFromPublishing": false,
        "com.figma.codeSyntax": {
          "Web": "var(--borderRadius-medium) /* utility class: .rounded-2 */"
        }
      },
      "$type": "number",
      "$value": 6
    },
    "full": {
      "$extensions": {
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.hiddenFromPublishing": false,
        "com.figma.codeSyntax": {
          "Web": "var(--borderRadius-full) /* utility class: .circle */"
        }
      },
      "$type": "number",
      "$value": 9999,
      "$description": "Use this border radius for pill shaped elements"
    },
    "small": {
      "$extensions": {
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ],
        "com.figma.hiddenFromPublishing": false,
        "com.figma.codeSyntax": {
          "Web": "var(--borderRadius-small) /* utility class: .rounded-1 */"
        }
      },
      "$type": "number",
      "$value": 4
    }
  },
  "space": {
    "xxsmall": {
      "$extensions": {
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 2
    },
    "xsmall": {
      "$extensions": {
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": "{base.size.4}"
    },
    "xlarge": {
      "$extensions": {
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": "{base.size.16}"
    },
    "small": {
      "$extensions": {
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 6
    },
    "medium": {
      "$extensions": {
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": "{base.size.8}"
    },
    "large": {
      "$extensions": {
        "com.figma.scopes": [
          "GAP"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": "{base.size.12}"
    }
  },
